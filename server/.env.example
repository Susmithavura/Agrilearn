# Copy this file to .env and provide local values. Never commit .env.
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agrilearn_db
DB_USER=agrilearn_app
DB_PASSWORD=
DB_APP_ALLOWED_HOST=localhost
DB_SSL_CA=
DB_SSL_VERIFY_CERT=0
DB_SSL_VERIFY_IDENTITY=0

# Setup-only credentials, used only by scripts/setup_database.py to create the
# schema and the least-privilege app account. Do not configure for normal runs.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_ADMIN_HOST=127.0.0.1
MYSQL_ADMIN_PORT=3306

# If empty, setup_database.py securely prompts for a new app-user password.
DB_SETUP_PASSWORD=
